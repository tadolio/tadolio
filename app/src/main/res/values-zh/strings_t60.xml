<!-- Modified by Tadolio contributors (2026) -->
<resources>
    <string name="t60_welcome_title">你好，我是 Tadolio</string>
    <string name="t60_welcome_body">说一句话，我替你在手机上办。</string>
    <string name="t60_start_free">免费开始</string>
    <string name="t60_connect_model">连接模型</string>
    <string name="t60_own_model">用自己的模型</string>
    <string name="t60_community_notice">免费算力来自社区成员，他们能看到任务内容和屏幕。</string>
    <string name="t60_free_details">免费是怎么回事？</string>
    <string name="t60_free_explanation">社区里的矿工或服务商用他们自己的模型帮你办事。\n\n内容加密后经 Tadolio 平台转交。你仍需要信任平台，理论上它有办法换掉加密钥匙、看到内容。\n\n有的矿工用云端按量 API，内容会经过标明的那家公司。\n\n他们能看到任务内容和屏幕，包括你让它打开的聊天、银行等 App 的画面。介意的话，请用自己的模型。\n\n免费使用不挣金币。</string>
    <string name="t60_model_title">用哪家的模型？</string>
    <string name="t60_model_body">登录账号最省事，不用填 Key。</string>
    <string name="t60_signin_chatgpt">ChatGPT 登录</string>
    <string name="t60_signin_grok">Grok 登录</string>
    <string name="t60_signin_openrouter">OpenRouter 登录</string>
    <string name="t60_why">为什么要这样？</string>
    <string name="t60_setup">开始设置</string>
    <string name="t60_accessibility_title">先开一个开关</string>
    <string name="t60_accessibility_body">打开「无障碍」，我才能替你看屏幕、点屏幕。</string>
    <string name="t60_accessibility_notice">我只办你交代的事；付钱、发消息前一定先问你。</string>
    <string name="t60_accessibility_steps">① 已下载的应用 → ② Tadolio → ③ 打开开关</string>
    <string name="t60_open">去打开</string>
    <string name="t60_auto_title">接下来我自己点</string>
    <string name="t60_auto_body">你看着就行。要输锁屏密码或点「允许」时，交给你。</string>
    <string name="t60_auto_steps">开发者选项 · 无线调试 · 配对</string>
    <string name="t60_password_title">请输入锁屏密码</string>
    <string name="t60_password_body">我等你。</string>
    <string name="t60_wifi_title">先连上 Wi-Fi</string>
    <string name="t60_wifi_body">不用能上网，连着就行。</string>
    <string name="t60_wifi_open">打开 Wi-Fi 设置</string>
    <string name="t60_notifications_title">最后一步：允许通知</string>
    <string name="t60_notifications_body">要你拍板的时候，我发通知叫你。</string>
    <string name="t60_notifications_pair_body">配对码要填在通知里，先允许通知。</string>
    <string name="t60_notifications_allow">允许通知</string>
    <string name="t60_notifications_explanation">付钱、发消息、删除这类事，我会先停下来问你。你不在 Tadolio 里时，只能靠通知找到你。任务做完也用它告诉你。</string>
    <string name="t60_unrestrict_title">系统拦了一下</string>
    <string name="t60_unrestrict_body">新装的 App 要先解除限制，只需一次。</string>
    <string name="t60_unrestrict_steps">① 右上角 ⋮ → ② 允许受限制的设置 → ③ 输锁屏密码</string>
    <string name="t60_unrestrict_toast">点右上角 ⋮ →「允许受限制的设置」</string>
    <string name="t60_unblock">去解除限制</string>
    <string name="t60_alternate">没有这一项？换个办法</string>
    <string name="t60_unrestrict_explanation">从浏览器装的 App，安卓默认不让它开无障碍，防的是来路不明的 App。这是你自己装的，解除一次就行。</string>
    <string name="t60_code_title">换个办法：填一次 6 位数</string>
    <string name="t60_code_body">等下系统会给你 6 位数。记住它，下拉通知栏，填进 Tadolio 的通知。</string>
    <string name="t60_code_steps">① 记住 6 位数 → ② 下拉通知栏 → ③ 点「填配对码」</string>
    <string name="t60_code_start">知道了，开始</string>
    <string name="t60_code_preview">现在就可以下拉看一眼，它已经在那儿了。</string>
    <string name="t60_code_explanation">这 6 位数是安卓「无线调试」的配对码，用来授权 Tadolio 在这台手机上启动内置助手。只在本机用，不发到网上，只要配一次。配好后我会自己把无障碍打开。</string>
    <string name="t60_developer_title">连点 7 下「版本号」</string>
    <string name="t60_developer_body">在「关于手机」里找到「版本号」，连点 7 下。</string>
    <string name="t60_developer_steps">① 关于手机 → ② 版本号 ×7</string>
    <string name="t60_developer_oppo">① 关于本机 → ② 版本信息 → ③ 版本号 ×7</string>
    <string name="t60_developer_samsung">① 关于手机 → ② 软件信息 → ③ 版本号 ×7</string>
    <string name="t60_developer_toast">连点「版本号」7 下</string>
    <string name="t60_about_open">去关于手机</string>
    <string name="t60_wireless_title">打开「无线调试」</string>
    <string name="t60_wireless_body">往下滑找到「无线调试」，打开，弹窗点「允许」。</string>
    <string name="t60_wireless_toast">打开「无线调试」，点「允许」</string>
    <string name="t60_pair_title">点「使用配对码配对设备」</string>
    <string name="t60_pair_body">看到 6 位数后，下拉通知栏，填进 Tadolio 的通知。</string>
    <string name="t60_pair_open">去配对</string>
    <string name="t60_pair_toast">点「使用配对码配对设备」，记住 6 位数，再下拉通知栏</string>
    <string name="t60_pair_error">码不对或过期了。重新点一次，会换新的 6 位数。</string>
    <string name="t60_pair_closed">配对窗口关了。重新点一次再填。</string>
    <string name="t60_helper_title">正在自己打开无障碍…</string>
    <string name="t60_helper_body">稍等一下。</string>
    <string name="t60_stuck">卡住了？</string>
    <string name="t60_family">让家人帮我</string>
    <string name="t60_usb">用电脑启动（USB）</string>
    <string name="t60_copy_diagnostics">复制诊断信息</string>
    <string name="t60_help_explanation">只操作当前这一步。锁屏密码、无障碍开关和「允许」弹窗由你自己操作。</string>
    <string name="t60_manual_code_note">离开配对窗口它就会关，可以用分屏一边看一边填。</string>
    <string name="t60_battery_title">让 Tadolio 在后台不被关掉</string>
    <string name="t60_battery_allow">去允许</string>
    <string name="t60_referrer_title">谁推荐你来的？</string>
    <string name="t60_referrer_add">填推荐人</string>
    <string name="t60_referrer_dismiss">关闭</string>
    <string name="t60_all_set">设置好了，接着办。</string>
    <string name="t60_battery_manual">由你在系统设置里允许</string>
    <string name="t60_battery_explanation">安卓会先问你，再允许 Tadolio 持续在后台运行。</string>
    <string name="t60_provider_consent">选定服务商，就表示同意由他为你服务。</string>
</resources>
