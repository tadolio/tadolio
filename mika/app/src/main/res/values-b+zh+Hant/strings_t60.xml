<?xml version="1.0" encoding="utf-8"?>
<!-- Modified by Tadolio contributors (2026) -->
<resources>
    <string name="t60_welcome_title">你好，我是 Tadolio</string>
    <string name="t60_welcome_body">說一句話，我替你在手機上辦。</string>
    <string name="t60_start_free">免費開始</string>
    <string name="t60_connect_model">連接模型</string>
    <string name="t60_own_model">用自己的模型</string>
    <string name="t60_community_notice">免費算力來自社群成員，他們能看到任務內容和螢幕。</string>
    <string name="t60_free_details">免費是怎麼回事？</string>
    <string name="t60_free_explanation">社群裡的礦工或服務商用他們自己的模型幫你辦事。\n\n內容加密後經 Tadolio 平台轉交。你仍需要信任平台，理論上它有辦法換掉加密鑰匙、看到內容。\n\n有的礦工用雲端按量 API，內容會經過標明的那家公司。\n\n他們能看到任務內容和螢幕，包括你讓它打開的聊天、銀行等 App 的畫面。介意的話，請用自己的模型。\n\n免費使用不掙金幣。</string>
    <string name="t60_model_title">用哪家的模型？</string>
    <string name="t60_model_body">登入帳號最省事，不用填 Key。</string>
    <string name="t60_signin_chatgpt">ChatGPT 登入</string>
    <string name="t60_signin_grok">Grok 登入</string>
    <string name="t60_signin_openrouter">OpenRouter 登入</string>
    <string name="t60_why">為什麼要這樣？</string>
    <string name="t60_setup">開始設定</string>
    <string name="t60_accessibility_title">先開一個開關</string>
    <string name="t60_accessibility_body">開啟「無障礙」，我才能替你看螢幕、點螢幕。</string>
    <string name="t60_accessibility_notice">我只辦你交代的事，付錢、傳訊息前一定先問你。</string>
    <string name="t60_accessibility_steps">① 已下載的應用程式 → ② Tadolio → ③ 開啟開關</string>
    <string name="t60_open">去開啟</string>
    <string name="t60_auto_title">接下來我自己點</string>
    <string name="t60_auto_body">你看著就行。要輸入鎖定螢幕密碼或點「允許」時，交給你。</string>
    <string name="t60_auto_steps">開發人員選項 · 無線偵錯 · 配對</string>
    <string name="t60_password_title">請輸入鎖定螢幕密碼</string>
    <string name="t60_password_body">我等你。</string>
    <string name="t60_wifi_title">先連上 Wi-Fi</string>
    <string name="t60_wifi_body">不用能上網，連著就行。</string>
    <string name="t60_wifi_open">開啟 Wi-Fi 設定</string>
    <string name="t60_notifications_title">最後一步：允許通知</string>
    <string name="t60_notifications_body">要你決定的時候，我發通知叫你。</string>
    <string name="t60_notifications_pair_body">配對碼要填在通知裡，先允許通知。</string>
    <string name="t60_notifications_allow">允許通知</string>
    <string name="t60_notifications_explanation">付錢、傳訊息、刪除這類事，我會先停下來問你。你不在 Tadolio 裡時，只能靠通知找到你。任務完成也用它告訴你。</string>
    <string name="t60_unrestrict_title">系統攔了一下</string>
    <string name="t60_unrestrict_body">新裝的 App 要先解除限制，只需一次。</string>
    <string name="t60_unrestrict_steps">① 右上角 ⋮ → ② 允許受限制的設定 → ③ 輸入鎖定螢幕密碼</string>
    <string name="t60_unrestrict_toast">點右上角 ⋮ →「允許受限制的設定」</string>
    <string name="t60_unblock">去解除限制</string>
    <string name="t60_alternate">沒有這一項？換個辦法</string>
    <string name="t60_unrestrict_explanation">從瀏覽器裝的 App，安卓預設不讓它開無障礙，防的是來路不明的 App。這是你自己裝的，解除一次就行。</string>
    <string name="t60_code_title">換個辦法：填一次 6 位數</string>
    <string name="t60_code_body">等下系統會給你 6 位數。記住它，下拉通知欄，填進 Tadolio 的通知。</string>
    <string name="t60_code_steps">① 記住 6 位數 → ② 下拉通知欄 → ③ 點「填配對碼」</string>
    <string name="t60_code_start">知道了，開始</string>
    <string name="t60_code_preview">現在就可以下拉看一眼，它已經在那裡了。</string>
    <string name="t60_code_explanation">這 6 位數是安卓「無線偵錯」的配對碼，用來授權 Tadolio 在這台手機上啟動內建助手。只在本機用，不傳到網上，只要配一次。配好後我會自己把無障礙開啟。</string>
    <string name="t60_developer_title">連點 7 下「版本號」</string>
    <string name="t60_developer_body">在「關於手機」裡找到「版本號」，連點 7 下。</string>
    <string name="t60_developer_steps">① 關於手機 → ② 版本號 ×7</string>
    <string name="t60_developer_oppo">① 關於本機 → ② 版本資訊 → ③ 版本號 ×7</string>
    <string name="t60_developer_samsung">① 關於手機 → ② 軟體資訊 → ③ 版本號 ×7</string>
    <string name="t60_developer_toast">連點「版本號」7 下</string>
    <string name="t60_about_open">去關於手機</string>
    <string name="t60_wireless_title">開啟「無線偵錯」</string>
    <string name="t60_wireless_body">往下滑找到「無線偵錯」，開啟，彈窗點「允許」。</string>
    <string name="t60_wireless_toast">開啟「無線偵錯」，點「允許」</string>
    <string name="t60_pair_title">點「使用配對碼配對裝置」</string>
    <string name="t60_pair_body">看到 6 位數後，下拉通知欄，填進 Tadolio 的通知。</string>
    <string name="t60_pair_open">去配對</string>
    <string name="t60_pair_toast">點「使用配對碼配對裝置」，記住 6 位數，再下拉通知欄</string>
    <string name="t60_pair_error">碼不對或過期了。重新點一次，會換新的 6 位數。</string>
    <string name="t60_pair_closed">配對視窗關了。重新點一次再填。</string>
    <string name="t60_helper_title">正在自行開啟無障礙…</string>
    <string name="t60_helper_body">稍等一下。</string>
    <string name="t60_stuck">卡住了？</string>
    <string name="t60_family">讓家人幫我</string>
    <string name="t60_usb">用電腦啟動（USB）</string>
    <string name="t60_copy_diagnostics">複製診斷資訊</string>
    <string name="t60_help_explanation">只操作目前這一步。鎖定螢幕密碼、無障礙開關和「允許」彈窗由你自行操作。</string>
    <string name="t60_manual_code_note">離開配對視窗它就會關，可以用分割畫面一邊看一邊填。</string>
    <string name="t60_battery_title">讓 Tadolio 在背景不被關閉</string>
    <string name="t60_battery_allow">去允許</string>
    <string name="t60_referrer_title">誰推薦你來的？</string>
    <string name="t60_referrer_add">填推薦人</string>
    <string name="t60_referrer_dismiss">關閉</string>
    <string name="t60_all_set">設定好了，接著辦。</string>
    <string name="t60_battery_manual">由你在系統設定裡允許</string>
    <string name="t60_battery_explanation">安卓會先問你，再允許 Tadolio 持續在背景執行。</string>
    <string name="t60_provider_consent">選定服務商，就表示同意由他為你服務。</string>
</resources>
